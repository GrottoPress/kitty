{
  "name": "@grottopress/kitty",
  "type": "module",
  "version": "0.19.1",
  "description": "Kitty is a collection of utilities for SvelteKit",
  "license": "MIT",
  "author": {
    "name": "GrottoPress",
    "email": "info@grottopress.com",
    "url": "https://www.grottopress.com"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "svelte-kit sync && vite build",
    "package": "svelte-kit sync && svelte-package",
    "preview": "vite preview --port 3000",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest --watch=false tests/unit",
    "test:unit:watch": "pnpm run test:unit -- --watch",
    "test:e2e": "playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3.0.0",
    "svelte": "^5.57.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GrottoPress/kitty.git"
  },
  "homepage": "https://github.com/GrottoPress/kitty#README",
  "keywords": [
    "svelte",
    "sveltekit"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "svelte": "./dist/server/index.js"
    }
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
